<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
{% if auto_refresh %}<meta http-equiv="refresh" content="{{ auto_refresh }}">{% endif %}
<title>{{ title }}</title>
<style>
  :root {
    --bg: #0f1115; --surface: #161a21; --surface-2: #1c2029;
    --border: #2a2f3a; --text: #e6e8ec; --muted: #9aa3b2;
    --accent: #7aa2ff; --ok: #4ade80; --human: #f472b6;
    --tool: #60a5fa; --agent: #c084fc; --mcp: #34d399; --cmd: #fb923c;
    --hook: #f87171; --rule: #facc15; --spine: #3a4150;
  }
  @media (prefers-color-scheme: light) {
    :root {
      --bg: #fafbfc; --surface: #ffffff; --surface-2: #f3f5f8;
      --border: #dfe3ea; --text: #1a1f2a; --muted: #5b6472;
      --accent: #2f5eff; --ok: #15803d; --human: #be185d;
      --tool: #2563eb; --agent: #7c3aed; --mcp: #059669; --cmd: #c2410c;
      --hook: #b91c1c; --rule: #a16207; --spine: #c9d0dc;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 40px 24px 120px; }
  .eyebrow { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  h1 { font-size: 30px; line-height: 1.2; margin: 6px 0 10px; font-weight: 700; letter-spacing: -0.01em; }
  .sub { color: var(--muted); font-size: 15px; max-width: 820px; }
  .meta-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-top: 22px; }
  .meta-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; }
  .meta-card .k { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 600; }
  .meta-card .v { font-size: 14px; margin-top: 3px; word-break: break-all; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .timeline { position: relative; margin-top: 40px; padding-left: 68px; }
  .timeline::before { content: ""; position: absolute; left: 27px; top: 12px; bottom: 60px; width: 2px; background: var(--spine); }
  .node { position: relative; margin-bottom: 28px; }
  .node::before {
    content: attr(data-n);
    position: absolute; left: -68px; top: 14px;
    width: 56px; height: 56px; border-radius: 50%;
    background: var(--bg); border: 3px solid var(--accent); color: var(--accent);
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 20px;
    box-shadow: 0 0 0 5px var(--bg); z-index: 2;
  }
  .node.human-node::before { border-color: var(--human); color: var(--human); }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 18px 22px; }
  .card.active-human { border-color: var(--human); border-left: 3px solid var(--human); }
  .card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .card-head .title { font-size: 17px; font-weight: 700; margin: 0 0 2px; letter-spacing: -0.005em; }
  .card-head .kicker { font-size: 12px; color: var(--muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .head-chips { display: flex; gap: 4px; flex-wrap: wrap; justify-content: flex-end; }
  .chip {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 600;
    border: 1px solid var(--border); background: var(--surface-2); color: var(--text);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .chip::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .chip.tool { color: var(--tool); }
  .chip.agent { color: var(--agent); }
  .chip.mcp { color: var(--mcp); }
  .chip.cmd { color: var(--cmd); }
  .chip.human { color: var(--human); }
  .chip.hook { color: var(--hook); }
  .layer { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 14px; }
  @media (max-width: 780px) { .layer { grid-template-columns: 1fr; } }
  .layer-box { background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; }
  .layer-box h5 { font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); margin: 0 0 6px; font-weight: 700; display: flex; align-items: center; gap: 6px; }
  .layer-box h5 .dot { width: 6px; height: 6px; border-radius: 50%; }
  .layer-box.generic h5 .dot { background: var(--accent); }
  .layer-box.specific h5 .dot { background: var(--ok); }
  .layer-box p { margin: 4px 0 0; font-size: 14px; }
  .block { margin-top: 14px; }
  .steps { padding-left: 22px; color: var(--muted); }
  .steps li { font-size: 13px; padding: 1px 0; }
  .steps li .mono { color: var(--accent); }
  table.artefacts { width: 100%; border-collapse: collapse; font-size: 13px; }
  table.artefacts th.cat {
    text-align: left; vertical-align: top; padding: 4px 12px 4px 0;
    color: var(--ok); font-weight: 600; text-transform: capitalize;
    white-space: nowrap; min-width: 140px;
  }
  table.artefacts td { padding: 4px 0; color: var(--text); }
  table.artefacts tr + tr th, table.artefacts tr + tr td {
    border-top: 1px dashed var(--border);
  }
  .block h4 { font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); margin: 0 0 8px; font-weight: 700; }
  .block ul { margin: 0; padding-left: 18px; }
  .block ul li { margin: 3px 0; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; background: var(--surface-2); padding: 1px 6px; border-radius: 4px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .human-box {
    background: linear-gradient(to right, var(--surface-2), var(--surface));
    border: 1px solid var(--human); border-left: 3px solid var(--human);
    border-radius: 10px; padding: 12px 14px; margin-top: 14px;
  }
  .human-box .hl { display: inline-flex; gap: 6px; font-size: 11px; font-weight: 700; color: var(--human); text-transform: uppercase; letter-spacing: 0.1em; }
  .human-box .quote { margin: 6px 0 0; font-style: italic; color: var(--text); }
  .human-box .quote::before { content: "\201C"; color: var(--human); font-weight: 700; font-style: normal; margin-right: 2px; }
  .human-box .quote::after { content: "\201D"; color: var(--human); font-weight: 700; font-style: normal; margin-left: 2px; }
  .human-box .quote + .quote { margin-top: 6px; }
  .human-box .resp { margin: 8px 0 0; font-size: 13px; color: var(--muted); }
  .reason { background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px; padding: 10px 14px; margin-top: 14px; }
  .reason .row { display: grid; grid-template-columns: 100px 1fr; gap: 10px; padding: 4px 0; border-top: 1px dashed var(--border); }
  .reason .row:first-child { border-top: none; }
  .reason .row .k { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 700; padding-top: 2px; }
  .reason .row .v { font-size: 14px; }
  .end-cap { position: relative; margin-top: -10px; }
  .end-cap::before {
    content: "\2713";
    position: absolute; left: -68px; top: 0;
    width: 56px; height: 56px; border-radius: 50%;
    background: var(--ok); border: 3px solid var(--ok); color: var(--bg);
    display: flex; align-items: center; justify-content: center;
    font-weight: 900; font-size: 28px;
    box-shadow: 0 0 0 5px var(--bg);
  }
  .end-cap-card { background: var(--surface); border: 1px solid var(--ok); border-radius: 14px; padding: 18px 22px; }
  .end-cap-card h3 { margin: 0 0 6px; color: var(--ok); font-size: 16px; }
  .pipeline-strip { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 18px 22px; margin: 24px 0 0; }
  .pipeline-strip h2 { margin: 0 0 6px; font-size: 15px; }
  .pipeline-strip .desc { color: var(--muted); font-size: 13px; margin-bottom: 12px; }
  .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin: 22px 0; }
  .kpi { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px; text-align: center; }
  .kpi .n { font-size: 22px; font-weight: 700; color: var(--accent); }
  .kpi .l { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 4px; }
  footer { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--border); color: var(--muted); font-size: 12px; }
  footer p { margin: 6px 0; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="eyebrow">Claude Code Session Walkthrough{% if auto_refresh %} · <span style="color: var(--ok);">● live</span> · last updated {{ rendered_at }} (refresh {{ auto_refresh }}s){% endif %}</div>
    <h1>{{ title }}</h1>
    <p class="sub">{{ narrative.one_line_summary or "Static analysis only — narrative synthesis disabled." }}</p>
    <div class="meta-grid">
      <div class="meta-card"><div class="k">Session ID</div><div class="v">{{ session.session_id }}</div></div>
      {%- if session.title %}
      <div class="meta-card"><div class="k">AI title</div><div class="v">{{ session.title }}</div></div>
      {%- endif %}
      {%- if session.git_branch %}
      <div class="meta-card"><div class="k">Branch</div><div class="v">{{ session.git_branch }}</div></div>
      {%- endif %}
      <div class="meta-card"><div class="k">Active duration</div><div class="v">{{ duration_pretty }}</div></div>
      <div class="meta-card"><div class="k">Tokens (in+out)</div><div class="v">{{ total_tokens_pretty }}</div></div>
      <div class="meta-card"><div class="k">Cache tokens (read+write)</div><div class="v">{{ cache_tokens_pretty }}</div></div>
      {%- if cost_usd %}
      <div class="meta-card"><div class="k">Est. cost</div><div class="v">${{ "%.2f"|format(cost_usd) }} USD</div></div>
      {%- endif %}
      {%- if session.cwd %}
      <div class="meta-card" style="grid-column: span 2;"><div class="k">cwd</div><div class="v">{{ session.cwd }}</div></div>
      {%- endif %}
    </div>
  </header>

  <div class="timeline">
    {%- for ph, narr in phases_with_narrative %}
    <section class="node{% if ph.interventions %} human-node{% endif %}" data-n="{{ ph.index }}">
      <div class="card{% if ph.interventions %} active-human{% endif %}">
        <div class="card-head">
          <div>
            <div class="title">{{ ph.title }}</div>
            <div class="kicker">{{ ph.start.strftime("%H:%M:%S") }} &rarr; {{ ph.end.strftime("%H:%M:%S") }} &middot; <strong>duration: {{ ph.duration_pretty }}</strong></div>
          </div>
          <div class="head-chips">
            {%- if ph.slash_command %}<span class="chip cmd">/{{ ph.slash_command }}</span>{%- endif %}
            {%- for agent_name, n in ph.metrics.subagent_calls.most_common(4) %}
            <span class="chip agent">{{ agent_name }} &times;{{ n }}</span>
            {%- endfor %}
            {%- if ph.interventions %}<span class="chip human">human-in-loop</span>{%- endif %}
          </div>
        </div>

        {%- if narr.generic_purpose or narr.specific_run %}
        <div class="layer">
          <div class="layer-box generic">
            <h5><span class="dot"></span>Generic purpose</h5>
            <p>{{ narr.generic_purpose }}</p>
          </div>
          <div class="layer-box specific">
            <h5><span class="dot"></span>This run</h5>
            <p>{{ narr.specific_run }}</p>
          </div>
        </div>
        {%- endif %}

        {%- if ph.metrics.tool_counts %}
        <div class="block">
          <h4>Tools fired</h4>
          <div class="chips">
            {%- for name, n in ph.metrics.tool_counts.most_common(12) %}
              {%- if name.startswith("mcp__") %}
                <span class="chip mcp">{{ name }} &times;{{ n }}</span>
              {%- elif name in ("Agent","Task") %}
                <span class="chip agent">{{ name }} &times;{{ n }}</span>
              {%- else %}
                <span class="chip tool">{{ name }} &times;{{ n }}</span>
              {%- endif %}
            {%- endfor %}
          </div>
        </div>
        {%- endif %}

        {%- if ph.metrics.steps_walked %}
        <div class="block">
          <h4>Sub-steps walked</h4>
          <ol class="steps">
            {%- for s in ph.metrics.steps_walked %}<li><span class="mono">{{ s }}</span></li>{%- endfor %}
          </ol>
        </div>
        {%- endif %}

        {%- if ph.metrics.artefacts %}
        <div class="block">
          <h4>Artefacts produced / updated</h4>
          <table class="artefacts">
            <tbody>
            {%- for category, files in ph.metrics.artefacts.items() %}
              <tr>
                <th class="cat">{{ category.replace('_', ' ') }}</th>
                <td>
                  {%- for f in files %}<div class="mono">{{ f }}</div>{%- endfor %}
                </td>
              </tr>
            {%- endfor %}
            </tbody>
          </table>
        </div>
        {%- endif %}

        {%- if ph.metrics.files_written or ph.metrics.files_edited %}
        <div class="block">
          <h4>Files touched</h4>
          <ul>
            {%- for f in ph.metrics.files_written[:8] %}<li>Written: <span class="mono">{{ f }}</span></li>{%- endfor %}
            {%- for f in ph.metrics.files_edited[:8] %}<li>Edited: <span class="mono">{{ f }}</span></li>{%- endfor %}
          </ul>
        </div>
        {%- endif %}

        {%- if ph.interventions %}
        <div class="human-box">
          <div class="hl">&#9733; Human-in-loop &middot; {{ ph.interventions|length }} intervention(s)</div>
          {%- for h in ph.interventions[:3] %}
          <p class="quote">{{ h.text }}</p>
          {%- endfor %}
          {%- if narr.intervention_resp %}<p class="resp">{{ narr.intervention_resp }}</p>{%- endif %}
        </div>
        {%- endif %}

        {%- if narr.known or narr.unknown or narr.reveals %}
        <div class="reason">
          {%- if narr.known %}<div class="row"><div class="k">Known</div><div class="v">{{ narr.known }}</div></div>{%- endif %}
          {%- if narr.unknown %}<div class="row"><div class="k">Unknown</div><div class="v">{{ narr.unknown }}</div></div>{%- endif %}
          {%- if narr.reveals %}<div class="row"><div class="k">Reveals</div><div class="v">{{ narr.reveals }}</div></div>{%- endif %}
        </div>
        {%- endif %}
      </div>
    </section>
    {%- endfor %}

    <section class="end-cap">
      <div class="end-cap-card">
        <h3>{{ narrative.end_cap_title }}</h3>
        <p style="margin:0;color:var(--muted);font-size:14px;">{{ narrative.end_cap_body }}</p>
      </div>
    </section>
  </div>

  <section class="pipeline-strip">
    <h2>By the numbers</h2>
    <div class="kpi-grid">
      <div class="kpi"><div class="n">{{ session.raw_count }}</div><div class="l">JSONL records</div></div>
      <div class="kpi"><div class="n">{{ slash_command_count }}</div><div class="l">slash commands</div></div>
      <div class="kpi"><div class="n">{{ subagent_total }}</div><div class="l">subagent calls</div></div>
      <div class="kpi"><div class="n">{{ bash_total }}</div><div class="l">Bash calls</div></div>
      <div class="kpi"><div class="n">{{ edit_total }}</div><div class="l">Edit calls</div></div>
      <div class="kpi"><div class="n">{{ mcp_total }}</div><div class="l">MCP calls</div></div>
      <div class="kpi"><div class="n">{{ total_tokens_pretty }}</div><div class="l">tokens (in+out)</div></div>
      <div class="kpi"><div class="n">{{ cache_tokens_pretty }}</div><div class="l">cache tokens (read+write)</div></div>
      {%- if cost_usd %}
      <div class="kpi"><div class="n">${{ "%.2f"|format(cost_usd) }}</div><div class="l">est. cost</div></div>
      {%- endif %}
    </div>
  </section>

  <section class="pipeline-strip" style="margin-top:24px;">
    <h2>Token breakdown</h2>
    <div class="kpi-grid">
      <div class="kpi"><div class="n">{{ "{:,}".format(totals.input_tokens) }}</div><div class="l">input</div></div>
      <div class="kpi"><div class="n">{{ "{:,}".format(totals.output_tokens) }}</div><div class="l">output</div></div>
      <div class="kpi"><div class="n">{{ "{:,}".format(totals.cache_create_tokens) }}</div><div class="l">cache write</div></div>
      <div class="kpi"><div class="n">{{ "{:,}".format(totals.cache_read_tokens) }}</div><div class="l">cache read</div></div>
    </div>
  </section>

  {%- if narrative.pattern_worth_keeping %}
  <footer>
    <p><strong>Pattern worth keeping:</strong> {{ narrative.pattern_worth_keeping }}</p>
    <p>Generated by <span class="mono">harness analyse</span>. Static parser + Claude CLI synthesis.</p>
  </footer>
  {%- else %}
  <footer>
    <p>Generated by <span class="mono">harness analyse</span>. Install Claude Code CLI for narrative synthesis.</p>
  </footer>
  {%- endif %}
</div>
</body>
</html>
