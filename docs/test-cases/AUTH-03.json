      "id": "AUTH-03-TC-01",
      "title": "Create user persists bcrypt hash, never plaintext",
      "type": "integration",
      "automatable": true,
      "priority": "Must",
      "requirement_id": "AUTH-03-FR-1",
      "given": "a valid create-user payload including a plaintext password",
      "when": "POST /api/users is submitted",
      "then": "the persisted password_hash column value is a bcrypt hash (identifiable bcrypt prefix), distinct from the submitted plaintext, and is never equal to the plaintext value",
      "tags": [
        "happy-path"
      ],
