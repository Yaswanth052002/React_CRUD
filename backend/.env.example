# SQLite file path (relative to backend/ directory)
DATABASE_URL=sqlite:///./users.db

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret key used to sign/verify JWT auth tokens. Required — the backend
# fails fast at startup if this is missing or empty. Never use this
# placeholder in production; generate a random value instead, e.g.
# `openssl rand -hex 32`. Never commit a real secret.
JWT_SECRET_KEY=CHANGE_ME
